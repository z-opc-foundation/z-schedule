<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        z-schedule 自包含 parent — 不依赖 monorepo 内部 parent,
        改造为 io.github.yuku123 namespace (Maven Central 命名空间).
        使用 ${revision} (CI-friendly versions) + flatten-maven-plugin 发版自动替换.

        模块结构:
          - z-schedule-core                     : 底层 entity/router/util
          - z-schedule-spring-boot-starter      : Spring Boot Starter (重命名自 z-schedule-web), 业务模块一行 import
        注: z-schedule-admin 是独立可启动演示应用，而它【确实在】reactor 内（下面 <modules> 里那一行
            的注释就是这件事；本行旧措辞写的是"不在 reactor"，与 <modules> 自相矛盾，已改口。
            要复核：mvn -B test 的 reactor 列表里 admin 是第 [4/4] 个模块）；
            它同时 maven.deploy.skip=true、且 parent 是 spring-boot-starter-parent（不继承本 pom 的
            central profile）⇒ 产物只作 docker 镜像源 / 本地 java -jar 演示，永不上 Maven Central。
    -->
    <groupId>io.github.yuku123</groupId>
    <artifactId>z-schedule</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>
    <name>z-schedule (Distributed Job Scheduler Aggregator)</name>
    <description>
        Z-Schedule: 分布式任务调度系统（对标 XXL-Job）。
        提供 Spring Boot Starter 集成 + AutoConfiguration + 集群协调（Leader / Schedule Ring / Schedule Engine）。
    </description>

    <url>https://github.com/yuku123/z-schedule</url>
    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>yuku123</id>
            <name>yuku123</name>
            <email>1340947819@qq.com</email>
            <organization>z-opc-foundation</organization>
            <organizationUrl>https://github.com/z-opc-foundation</organizationUrl>
            <timezone>+08:00</timezone>
            <roles>
                <role>owner</role>
            </roles>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:https://github.com/z-opc-foundation/z-schedule.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/z-opc-foundation/z-schedule.git</developerConnection>
        <url>https://github.com/z-opc-foundation/z-schedule</url>
        <tag>HEAD</tag>
    </scm>

    <modules>
        <module>z-schedule-core</module>
        <module>z-schedule-spring-boot-starter</module>
        <!--
            z-schedule-admin: 留 reactor 以享受统一构建，但 maven.deploy.skip=true，
            永远不上 Maven Central（产物仅作 docker 镜像源 / 本地 java -jar 演示）。
            详见 lead/005_技术架构/005_前端工程与中间件部署架构规范.md §2
        -->
        <module>z-schedule-admin</module>
    </modules>

    <properties>
        <!-- CI-friendly 版本根 (发版改这一处即可) -->
        <revision>1.0.5</revision>

        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- 第三方版本 -->
        <!-- 2026-09-28「同坐标单版本」：2.7.12 → 2.7.18（2.7 线最后一版，Java 8 可用），
             与 z-boot-dependencies 1.0.18 / z-opc 根 pom 同一口径；12→18 含 CVE 修复，纯上行。 -->
        <spring-boot.version>2.7.18</spring-boot.version>
        <druid.version>1.2.18</druid.version>
        <mysql.version>8.0.33</mysql.version>
        <log4j2.version>2.20.0</log4j2.version>
        <slf4j.version>1.7.36</slf4j.version>
        <mybatis-plus.version>3.5.7</mybatis-plus.version>

        <!-- 内部依赖 -->
        <z-boot.version>1.0.17</z-boot.version>
        <z-util.version>1.0.10</z-util.version>

        <!-- Maven 插件版本 -->
        <flatten-maven-plugin.version>1.7.3</flatten-maven-plugin.version>
        <central-publishing-maven-plugin.version>0.7.0</central-publishing-maven-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot BOM -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- 内部 module -->
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-schedule-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-schedule-spring-boot-starter</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- 第三方 BOM -->
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-bom</artifactId>
                <version>${log4j2.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-boot-dependencies</artifactId>
                <version>${z-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-util-core</artifactId>
                <version>${z-util.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>${flatten-maven-plugin.version}</version>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <!-- oss 模式: 子 POM 完全 self-contained,
                         自定义 ${xxx} 属性也会解析, url/licenses/developers/scm 元数据保留.
                         详见 lead/005_技术架构/004_flatten_maven_plugin_模式选择.md -->
                    <flattenMode>oss</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals><goal>flatten</goal></goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals><goal>clean</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>${maven.compiler.source}</source>
                        <target>${maven.compiler.target}</target>
                        <encoding>${project.build.sourceEncoding}</encoding>
                </configuration>
            </plugin>
            <!-- 不钉版本时"哪些测试会跑"是由构建机的 Maven 决定的：Maven 3.8.7 默认 surefire
                 2.12.4 没有 JUnit-Platform provider，admin 那 6 例 jupiter 用例会被静默跳过
                 （不红、不报，只是计数少一截）；本机 3.9.14 默认 3.5.4 才跑它们。
                 2026-09-27 两机实测：同一提交 323 vs 329。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.4</version>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>central</id>
            <properties>
                <maven.javadoc.skip>false</maven.javadoc.skip>
                <central.gpg.skip>false</central.gpg.skip>
            </properties>
            <distributionManagement>
                <repository>
                    <id>central</id>
                    <url>https://central.sonatype.com</url>
                </repository>
                <snapshotRepository>
                    <id>central</id>
                    <url>https://central.sonatype.com</url>
                </snapshotRepository>
            </distributionManagement>
            <build>
                <plugins>
                    <!-- 中央发布场景下，禁用 maven-deploy-plugin 的 default-deploy，
                         改由 central-publishing-maven-plugin 接管。
                         否则 maven-deploy-plugin 会尝试推到不存在的传统 repository，
                         触发 Invalid request / Broken pipe -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-deploy-plugin</artifactId>
                        <version>3.1.4</version>
                        <configuration>
                            <skip>true</skip>
                        </configuration>
                    </plugin>

                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals><goal>jar-no-fork</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.11.2</version>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals><goal>jar</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.7</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals><goal>sign</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>${central-publishing-maven-plugin.version}</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <tokenAuth>true</tokenAuth>
                            <autoPublish>true</autoPublish>
                            <waitUntil>uploaded</waitUntil>
                            <waitMaxTime>1800</waitMaxTime>
                            <waitPollingInterval>10</waitPollingInterval>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
