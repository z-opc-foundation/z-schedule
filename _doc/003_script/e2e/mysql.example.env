# z-schedule 真机验证环境的凭据模板。
#
# 复制成 $E2E_HOME/mysql.env 后填真值，并且 chmod 600。
# bootstrap_mysql.sh 在没有 mysql.env 时会用随机口令自动生成一份，正常情况下你不用手填。
#
# 这个文件永远不进仓库；mysql.env 已经在 .gitignore 里挡了一道。
# docker 用 --env-file 读它 ⇒ 口令不出现在 argv / ps / shell history 里。

MYSQL_DATABASE=zschedule_e2e
MYSQL_USER=zschedule
MYSQL_ROOT_PASSWORD=__ROOT__
MYSQL_PASSWORD=__APP__
