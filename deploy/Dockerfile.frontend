# Z-Schedule 前端 nginx 镜像（Mode 2 分体 / Mode 3 集群用）
# 输入：_frontend/z-schedule-frontend/ 的**源码**（package.json + src/；dist/ 在镜像里产出，不从宿主拷）
# 输出：nginx 静态服务 + /api 反代到 backend（BACKEND_SERVICE 由 compose/清单注入）
#
# 构建前置：无——npm ci 与 vite build 都在下面的 builder 阶段里跑。
#   （从前这里写的是"先在宿主跑 npm ci && npm run build"，那是假的：本文件一个字都没 COPY dist/，
#     照那句做完构建仍会成功，白跑一遍而已。）
#
# 构建命令（版本别抄死在这里，走 bin/build-images.sh 或 compose 的 build，
#   两处都用 ${OCI_REGISTRY}/z-schedule-frontend:${IMAGE_VERSION}，与清单里的 image: 名字逐字一致）：
#   docker build -f deploy/Dockerfile.frontend -t "$OCI_REGISTRY/z-schedule-frontend:$IMAGE_VERSION" ..

# ---- 构建阶段：基于 node 跑 vite build ----
FROM node:18-alpine AS builder

WORKDIR /build

# 仅拷 package.json 利用 docker layer 缓存
COPY _frontend/z-schedule-frontend/package.json ./
COPY _frontend/z-schedule-frontend/package-lock.json* ./
RUN npm ci --no-audit --no-fund

# 拷源码 + build
COPY _frontend/z-schedule-frontend/ ./
RUN npm run build

# ---- 运行阶段：nginx 静态服务 ----
FROM nginx:1.25-alpine

# 拷 nginx 配置 + 反代模板
COPY deploy/nginx.conf.template /etc/nginx/templates/default.conf.template

# 拷 build 产物
COPY --from=builder /build/dist /usr/share/nginx/html

EXPOSE 80

# 通过 envsubst 渲染 nginx 配置（BACKEND_SERVICE 在 compose 中注入）
# nginx:1.25-alpine 自带 envsubst-on-templates.sh 在 /docker-entrypoint.d/
# 这里我们用 envsubst 手动渲染到 /etc/nginx/conf.d/default.conf
CMD ["/bin/sh", "-c", "envsubst '$$BACKEND_SERVICE' < /etc/nginx/templates/default.conf.template > /etc/nginx/conf.d/default.conf && nginx -g 'daemon off;'"]

LABEL org.opencontainers.image.title="z-schedule-frontend" \
      org.opencontainers.image.description="Z-Schedule admin 前端 nginx 镜像" \
      org.opencontainers.image.source="https://github.com/yuku123/z-schedule" \
      org.opencontainers.image.licenses="MIT"