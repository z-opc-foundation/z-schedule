<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        z-schedule-admin: 独立可启动演示应用 (在 reactor 内——顶层 pom.xml 的 <modules> 列了本模块，
        统一构建会跑到本模块的测试；本地起法 mvn spring-boot:run 或 java -jar target/*-exec.jar).
        默认端口 / context-path 见 application.yml (18086 / meta)
        凭证: 读环境变量 SPRING_DATASOURCE_PASSWORD, 不在 application.yml 写明文.
              本地开发用 src/main/resources/application-local.yml (gitignored).
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.12</version>
        <relativePath/>
    </parent>

    <groupId>io.github.yuku123</groupId>
    <artifactId>z-schedule-admin</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>z-schedule :: admin (Standalone Demo App, NOT published to Central)</name>
    <description>
        Z-Schedule 独立可启动演示应用. 本地 spring-boot:run 启动一个完整的调度中心 UI.
        不入中央（机制有两条，都实测过：maven.deploy.skip=true；本模块的 parent 是
        spring-boot-starter-parent，不继承顶层 pom 的 central profile，故 central-publishing /
        gpg 那套插件在本模块 0 命中）。"不发"与"不在 reactor"是两件事——本模块在 reactor 内。
    </description>

    <properties>
        <java.version>8</java.version>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!--
            admin 独立 module, 没有 flatten 阶段, 字面写版本。
            必须与 z-schedule 顶层 pom 的 <revision> 保持一致（V1 留 reactor 后会参与 reactor 解析）。
            发版前同步更新本字段（或改用 ${revision} 显式注入，见 V1 验证记录）。
        -->
        <z-schedule.version>1.0.6</z-schedule.version>
        <!-- 2026-09-29 消费者轮：1.0.17 → 1.0.21。本模块的 <parent> 是 spring-boot-starter-parent
             （建仓就有的独立应用形状，maven.deploy.skip=true、永不上 Central），**不继承**顶层
             z-boot-parent 的直接 DM ⇒ 这里的版本必须自己写，删掉就是 "dependencies.dependency.version
             ... is missing" 硬失败（实测）。本仓其它模块由 z-boot-parent:1.0.21 供面值，这一格抬到同号
             是为了让 admin 与 reactor 其余部分吃同一份 z-boot starter（地板 1.0.20 已删 simpleclient=0.8.1、
             8 个聚合件不再转 log4j-slf4j2-impl）。 -->
        <z-boot.version>1.0.21</z-boot.version>
        <!-- 2026-09-29 消费者轮收尾：1.0.13 → 1.0.14。同一 reactor 里其余模块的 z-util-core 由
             继承来的 fleet 供 1.0.14（z-boot-fleet 里 z-util.version 那一格），
             这一格留 1.0.13 就是仓内一条半新半旧的线；且 z-util 1.0.14 是 2026-09-29 那批已发布的
             新号，1.0.13 只是它的上一版 ⇒ admin 打的镜像吃的是旧字节码。键必须留（同上：不继承父链 DM）。

             2026-10-05：1.0.14 → 1.0.18。fleet 那一格已同步抬到 1.0.18（6ef352a），
             这一格若还钉 1.0.14 就会把 admin 单独留在旧字节码上，与 fleet 脱钩。
             实测 -Dz-util.version=1.0.18 全量：335 测 0 失 0 错，与 1.0.14 基线逐条一致
             （45 + 284 + 6），升版无回归。 -->
        <z-util.version>1.0.18</z-util.version>

        <!--
            admin 是 standalone demo + docker 镜像源，永远不上 Maven Central。
            保留在 reactor 以享受统一构建（mvn package / install / -pl admin -am 都能用），
            但 deploy 阶段自动跳过。
            详见 lead/005_技术架构/005_前端工程与中间件部署架构规范.md §2
        -->
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <!-- 本仓核心 starter: 提供调度 + 集群 + REST -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-schedule-spring-boot-starter</artifactId>
            <version>${z-schedule.version}</version>
        </dependency>

        <!-- z-boot: 默认配置。⚠ 本模块的 <parent> 是 spring-boot-starter-parent:2.7.12，
             不是 z-boot-parent ⇒ 父链那条直接 DM 在这里**不生效**，版本必须自己写面值
             （删掉就是 'dependencies.dependency.version ... is missing' 硬失败，2026-09-29 实测）。 -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-boot-web-starter</artifactId>
            <version>${z-boot.version}</version>
        </dependency>
        <!--
            SLF4J 绑定只留一条，且必须留 **1.7 那一代**（log4j-slf4j-impl，配 slf4j-api 1.7.36）。
            原先这里排除的是 log4j-slf4j-impl、留下 z-util-core 带的 log4j-slf4j2-impl 2.26.1
            （SLF4J **2.x** 的 Provider 绑定）——而本仓解析到的 slf4j-api 是 Boot 2.7 管的 1.7.36，
            它只认 StaticLoggerBinder，不认 ServiceLoader ⇒ 结果是**一支绑定都没接上**：
            admin 起来时 stdout 打 "SLF4J: Failed to load class org.slf4j.impl.StaticLoggerBinder /
            Defaulting to no-operation (NOP) logger implementation"，凡走 SLF4J 的日志静默丢弃。
            实测受影响的这一格：本模块 DevDataSourceConfig 那行 INFO 在 stdout 里 0 命中，
            而同一进程里走 log4j2 原生 Logger 的 LeaderElector WARN 照打（两套门面只差在这条绑定上）。
            判据与复现见 _doc/003_script/e2e/p44.sh 的 C3b 与 _doc/003_script/e2e/README.md §21。
            两条同时成立才叫"一套绑定"：2.26.1 的绑定还依赖 log4j-api 2.20+，而本仓 log4j-core 是 2.17.2
            （这正是老注释说的 NoSuchMethodError 出处）⇒ 摘掉 2.x 绑定同时也消掉那个冲突。
        -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-boot-datasource-starter</artifactId>
            <version>${z-boot.version}</version>
        </dependency>

        <!-- 工具（排除它带的 SLF4J 2.x 绑定，理由见上面那段） -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-util-core</artifactId>
            <version>${z-util.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>org.apache.logging.log4j</groupId>
                    <artifactId>log4j-slf4j2-impl</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Actuator (健康检查) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Log4j2 (starter / z-boot-web-starter 统一使用 log4j2) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-log4j2</artifactId>
        </dependency>

        <!-- H2 Database (本地测试用, 生产换 MySQL) -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                V2 改造：frontend-maven-plugin 在 process-resources 阶段跑 npm build
                workingDirectory 指向 _frontend/z-schedule-frontend/（仓根下，不在 reactor 内）
                产物 dist/ → 由下面 maven-resources-plugin 复制到 src/main/resources/static/
                详见 lead/005_技术架构/005_前端工程与中间件部署架构规范.md §1.2 / §6.1 V2
            -->
            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <version>1.15.0</version>
                <configuration>
                    <workingDirectory>${project.basedir}/../_frontend/z-schedule-frontend</workingDirectory>
                    <installDirectory>${project.build.directory}/frontend</installDirectory>
                </configuration>
                <executions>
                    <execution>
                        <id>install-node-and-npm</id>
                        <goals>
                            <goal>install-node-and-npm</goal>
                        </goals>
                        <phase>generate-resources</phase>
                        <configuration>
                            <nodeVersion>v18.17.0</nodeVersion>
                            <npmVersion>9.6.7</npmVersion>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm-install</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <phase>generate-resources</phase>
                        <configuration>
                            <arguments>install</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm-run-build</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <phase>generate-resources</phase>
                        <configuration>
                            <arguments>run build</arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
                V2 改造：把 _frontend/z-schedule-frontend/dist/ 复制到 target/classes/static/
                （不复制到 src/main/resources/static/，避免污染源码目录 + git 噪声）
                必须在 frontend-maven-plugin 跑完之后（process-resources > generate-resources）
                且在默认 maven-resources-plugin 之后（process-resources 阶段默认 src/main/resources -> target/classes）
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-frontend-dist</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/static</outputDirectory>
                            <overwrite>true</overwrite>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/../_frontend/z-schedule-frontend/dist</directory>
                                    <filtering>false</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- V1 改造：admin 永远不上 Central，但保留在 reactor 以享受统一构建 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <!--
                            execution id 必须是 repackage：spring-boot-starter-parent 自带一个同 id 的
                            repackage execution，不覆盖它就会出现两次 repackage——主 jar 先被就地换成 fat，
                            再由这里 attach 一个 exec。2026-09-26 在 250 真机起 exec jar 时实测到：
                            两次的输入输出串了，exec jar 的 Start-Class 变成 JarLauncher，
                            java -jar 直接 ClassNotFoundException。z-wf-admin 早写过这条注释，本模块漏了 id。

                            同时刻意不写 mainClass：手写全限定类名等于第二处真源，包名一改就静默失效——
                            这里原本写着改名前的 io.github.yuku123.z.schedule.admin.ZScheduleAdminApplication，
                            于是 exec jar 的 Start-Class 指向一个不存在的类，"独立可启动演示应用"一次都没启动过。
                            交给插件从 thin jar 里找唯一带 main 的类，找不到或有多个时构建当场失败。
                        -->
                        <id>repackage</id>
                        <goals><goal>repackage</goal></goals>
                        <configuration>
                            <classifier>exec</classifier>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
