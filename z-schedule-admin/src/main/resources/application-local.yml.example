# z-schedule-admin 本地开发配置（示例）
#
# ⚠️ 此文件加入 .gitignore，绝不 commit
# ⚠️ 真实密码必须到阿里云 RDS 控制台重置（不能复用 git 历史泄露的旧密码）
#
# 用法：
#   cp src/main/resources/application-local.yml.example src/main/resources/application-local.yml
#   编辑 application-local.yml 填入本地真实值
#   启动：mvn spring-boot:run --spring.profiles.active=local

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/zschedule_dev       # 本地或内网 MySQL
    username: root
    password: <YOUR_LOCAL_DB_PASSWORD>                    # 本地密码, 不需要保护
