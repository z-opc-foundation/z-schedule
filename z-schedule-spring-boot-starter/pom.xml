<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ${revision} ONLY inside <parent>.version, NOT at project level -->
    <parent>
        <groupId>io.github.yuku123</groupId>
        <artifactId>z-schedule</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>z-schedule-spring-boot-starter</artifactId>
    <packaging>jar</packaging>
    <name>z-schedule :: spring-boot-starter (Scheduler + Cluster + REST API auto-config)</name>
    <description>
        Z-Schedule Spring Boot Starter: 调度中心 AutoConfiguration + 集群协调 (Leader / Schedule Ring / Schedule Engine) + REST API.
        业务模块只需 &lt;dependency&gt;io.github.yuku123:z-schedule-spring-boot-starter&lt;/dependency&gt; 一行集成.
    </description>
    <url>https://github.com/z-opc-foundation/z-schedule/tree/main/z-schedule-spring-boot-starter</url>
    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>yuku123</id>
            <name>yuku123</name>
            <email>1340947819@qq.com</email>
            <organization>z-opc-foundation</organization>
            <organizationUrl>https://github.com/z-opc-foundation</organizationUrl>
            <timezone>+08:00</timezone>
            <roles>
                <role>owner</role>
            </roles>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:https://github.com/z-opc-foundation/z-schedule.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/z-opc-foundation/z-schedule.git</developerConnection>
        <url>https://github.com/z-opc-foundation/z-schedule</url>
        <tag>HEAD</tag>
    </scm>

    <!-- 本模块不再自摊版本键：z-boot 自家 starter 走 z-boot-parent 的 z-boot-self 直接条目（1.0.19），
         z-util-core 走 z-boot-fleet（1.0.13，与本仓迁移前的格子面值相同），
         mybatis-plus-extension / spring-boot-autoconfigure / h2 由第三方地板下发，
         log4j-api 由本仓根 pom 的**直接** DM 条目钉在迁移前实测的 2.17.2。
         原来躺在这里的 z-boot.version / z-util.version 两格已删（引用一并删）。 -->

    <dependencies>
        <!-- z-schedule-core: 业务 entity/router/util（版本由本仓根 pom 的 ${project.version} 下发） -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-schedule-core</artifactId>
        </dependency>

        <!-- z-boot: 版本与口径都由 parent 链下发（迁移前这里还写了一条
             io.github.yuku123:z-boot-dependencies:1.0.17 的 <scope>import</scope>，
             但它站在 <dependencies> 里 —— 只有 <dependencyManagement> 里的 import 才生效，
             在 <dependencies> 里它只是"依赖一个 pom 类型的件"，实测在消费者树里留下
             z-boot-dependencies:pom:1.0.17:import 这一行（admin 树可见），对版本解析 0 贡献。
             删掉它 = 清掉一处假 import，本模块的 DM 一律从 z-boot-parent 走。 -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-boot-web-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-boot-datasource-starter</artifactId>
        </dependency>

        <!-- 工具 -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-util-core</artifactId>
        </dependency>

        <!-- MyBatis-Plus -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-extension</artifactId>
        </dependency>

        <!-- Spring Boot AutoConfigure 注册入口 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>

        <!-- Log4j2 API (本模块 src/main/java 含 LogManager.getLogger) -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
        </dependency>


        <!--
            仅测试用: JobLogMapperH2Test 要在真实数据库上跑聚合 SQL
            (DATE()/列标签大小写折叠/COALESCE 这些只有驱动能给答案).
            版本由 spring-boot-dependencies BOM 管理, 与 admin dev profile 同源.
        -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
