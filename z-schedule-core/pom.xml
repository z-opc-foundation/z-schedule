<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.yuku123</groupId>
        <artifactId>z-schedule</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>z-schedule-core</artifactId>
    <packaging>jar</packaging>
    <name>z-schedule-core (底层 entity/router/util, 调度核心基础)</name>
    <description>
        Z-Schedule 底层核心模块: 任务/执行器/日志的实体定义 + MyBatis-Plus mapper + 路由抽象 + 通用工具。
        上层 z-schedule-spring-boot-starter 依赖本模块, 业务方通常直接 import starter。
    </description>
    <url>https://github.com/z-opc-foundation/z-schedule/tree/main/z-schedule-core</url>
    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>yuku123</id>
            <name>yuku123</name>
            <email>1340947819@qq.com</email>
            <organization>z-opc-foundation</organization>
            <organizationUrl>https://github.com/z-opc-foundation</organizationUrl>
            <timezone>+08:00</timezone>
            <roles>
                <role>owner</role>
            </roles>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:https://github.com/z-opc-foundation/z-schedule.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/z-opc-foundation/z-schedule.git</developerConnection>
        <url>https://github.com/z-opc-foundation/z-schedule</url>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <!-- maven.compiler.source/target 与 project.build.sourceEncoding 由 z-boot-parent 下发
             （面值 8 / 8 / UTF-8，与本模块迁移前手抄的三条同值；产物仍是 class-file major 52）。
             slf4j.version 这一格**留着**：父链没有按坐标直接管 org.slf4j:slf4j-api
             （只有地板 import 的 spring-boot-dependencies 把它展成 1.7.36，而 import 顶不过
             继承来的直接 DM ⇒ 判"供不供"要按坐标判，见 README 步骤 3），删键即当场悬空。
             面值 1.7.36 与迁移前实测一致（tree：org.slf4j:slf4j-api:jar:1.7.36:compile）。 -->
        <slf4j.version>1.7.36</slf4j.version>
    </properties>

    <dependencies>
        <!-- SLF4J -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>

        <!-- JUnit for testing -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
